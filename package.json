{
  "name": "davinci-ai-smart-commiter",
  "displayName": "Davinci AI Smart Commiter",
  "description": "Generate Conventional Commits messages from your staged git diff using Claude, OpenAI, Kimi, DeepSeek, or Gemini.",
  "version": "0.0.4",
  "publisher": "local",
  "author": {
    "name": "Ludovick Konyo",
    "email": "developer@socialsmarttech.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/socialsmarttech/davinci-ai-smart-commiter"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onCommand:aiCommitAssistant.generateCommitMessage",
    "onCommand:aiCommitAssistant.setup",
    "onCommand:aiCommitAssistant.selectProvider",
    "onCommand:aiCommitAssistant.selectModel",
    "onCommand:aiCommitAssistant.setAnthropicApiKey",
    "onCommand:aiCommitAssistant.setOpenAIApiKey",
    "onCommand:aiCommitAssistant.setKimiApiKey",
    "onCommand:aiCommitAssistant.setDeepSeekApiKey",
    "onCommand:aiCommitAssistant.setGeminiApiKey"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiCommitAssistant.generateCommitMessage",
        "title": "Davinci AI Smart Commiter: Generate Commit Message",
        "category": "Davinci AI Smart Commiter",
        "icon": {
          "light": "resources/sparkle-light.svg",
          "dark": "resources/sparkle-dark.svg"
        }
      },
      {
        "command": "aiCommitAssistant.setup",
        "title": "Davinci AI Smart Commiter: Setup Provider, Model, and API Key",
        "category": "Davinci AI Smart Commiter"
      },
      {
        "command": "aiCommitAssistant.selectProvider",
        "title": "Davinci AI Smart Commiter: Select Default Provider",
        "category": "Davinci AI Smart Commiter"
      },
      {
        "command": "aiCommitAssistant.selectModel",
        "title": "Davinci AI Smart Commiter: Select Default Model",
        "category": "Davinci AI Smart Commiter"
      },
      {
        "command": "aiCommitAssistant.setAnthropicApiKey",
        "title": "Davinci AI Smart Commiter: Set Anthropic API Key",
        "category": "Davinci AI Smart Commiter"
      },
      {
        "command": "aiCommitAssistant.setOpenAIApiKey",
        "title": "Davinci AI Smart Commiter: Set OpenAI API Key",
        "category": "Davinci AI Smart Commiter"
      },
      {
        "command": "aiCommitAssistant.setKimiApiKey",
        "title": "Davinci AI Smart Commiter: Set Kimi API Key",
        "category": "Davinci AI Smart Commiter"
      },
      {
        "command": "aiCommitAssistant.setDeepSeekApiKey",
        "title": "Davinci AI Smart Commiter: Set DeepSeek API Key",
        "category": "Davinci AI Smart Commiter"
      },
      {
        "command": "aiCommitAssistant.setGeminiApiKey",
        "title": "Davinci AI Smart Commiter: Set Gemini API Key",
        "category": "Davinci AI Smart Commiter"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "aiCommitAssistant.generateCommitMessage",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Davinci AI Smart Commiter",
      "properties": {
        "aiCommitAssistant.provider": {
          "type": "string",
          "default": "anthropic",
          "enum": ["anthropic", "openai", "kimi", "deepseek", "gemini"],
          "enumItemLabels": ["Anthropic Claude", "OpenAI", "Kimi K2 / Moonshot", "DeepSeek", "Google Gemini"],
          "markdownEnumDescriptions": [
            "Use Anthropic Messages API. Set the key with `Davinci AI Smart Commiter: Set Anthropic API Key`.",
            "Use OpenAI Chat Completions API. Set the key with `Davinci AI Smart Commiter: Set OpenAI API Key`.",
            "Use Kimi/Moonshot OpenAI-compatible API. Set the key with `Davinci AI Smart Commiter: Set Kimi API Key`.",
            "Use DeepSeek OpenAI-compatible API. Set the key with `Davinci AI Smart Commiter: Set DeepSeek API Key`.",
            "Use Google Gemini OpenAI-compatible API. Set the key with `Davinci AI Smart Commiter: Set Gemini API Key`."
          ],
          "order": 1,
          "markdownDescription": "Choose the AI provider used to generate commit messages. API keys are stored in VS Code Secret Storage via the matching `Set ... API Key` command."
        },
        "aiCommitAssistant.autoStage": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "markdownDescription": "Run `git add -A` before generating the commit message."
        },
        "aiCommitAssistant.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "order": 3,
          "markdownDescription": "Controls creativity. Lower values make commit messages more consistent."
        },
        "aiCommitAssistant.maxTokens": {
          "type": "number",
          "default": 360,
          "minimum": 64,
          "maximum": 4096,
          "order": 4,
          "markdownDescription": "Maximum tokens for the generated commit message. Keep this modest because the extension expects a single line."
        },
        "aiCommitAssistant.diff.maxChars": {
          "type": "number",
          "default": 35000,
          "minimum": 2000,
          "order": 5,
          "markdownDescription": "Maximum characters from `git diff --cached` to send to the model. Larger values give more detail but cost more tokens."
        },
        "aiCommitAssistant.context.maxFiles": {
          "type": "number",
          "default": 6,
          "minimum": 0,
          "maximum": 30,
          "order": 6,
          "markdownDescription": "Maximum staged source/config files to read as surrounding context. Set to `0` to disable context reading."
        },
        "aiCommitAssistant.context.maxChars": {
          "type": "number",
          "default": 12000,
          "minimum": 0,
          "maximum": 100000,
          "order": 7,
          "markdownDescription": "Maximum total characters of surrounding file context to send to the model."
        },
        "aiCommitAssistant.context.maxCharsPerFile": {
          "type": "number",
          "default": 4000,
          "minimum": 0,
          "maximum": 30000,
          "order": 8,
          "markdownDescription": "Maximum characters to include from each staged source/config file."
        },
        "aiCommitAssistant.anthropic.model": {
          "type": "string",
          "default": "claude-haiku-4-5-20251001",
          "enum": [
            "claude-haiku-4-5-20251001",
            "claude-sonnet-4-6",
            "claude-opus-4-7",
            "claude-3-haiku-20240307"
          ],
          "enumItemLabels": [
            "Claude Haiku 4.5",
            "Claude Sonnet 4.6",
            "Claude Opus 4.7",
            "Claude 3 Haiku"
          ],
          "markdownEnumDescriptions": [
            "Fast and cost-effective.",
            "Balanced speed and intelligence.",
            "Highest capability.",
            "Legacy fast model."
          ],
          "order": 20,
          "markdownDescription": "Anthropic model used when provider is `anthropic`. Use `Davinci AI Smart Commiter: Select Default Model` to change it without typing."
        },
        "aiCommitAssistant.anthropic.baseUrl": {
          "type": "string",
          "default": "https://api.anthropic.com",
          "order": 21,
          "markdownDescription": "Anthropic API base URL."
        },
        "aiCommitAssistant.openai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "enum": [
            "gpt-4o-mini",
            "gpt-5.4-mini",
            "gpt-5.4-nano",
            "gpt-5.4",
            "gpt-5.5"
          ],
          "enumItemLabels": [
            "GPT-4o mini",
            "GPT-5.4 mini",
            "GPT-5.4 nano",
            "GPT-5.4",
            "GPT-5.5"
          ],
          "markdownEnumDescriptions": [
            "Fast, affordable, reliable for commit messages.",
            "Stronger coding model, lower cost than flagship.",
            "Lowest latency and cost.",
            "Higher capability.",
            "Flagship coding and professional work model."
          ],
          "order": 30,
          "markdownDescription": "OpenAI model used when provider is `openai`. Use `Davinci AI Smart Commiter: Select Default Model` to change it without typing."
        },
        "aiCommitAssistant.openai.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com",
          "order": 31,
          "markdownDescription": "OpenAI API base URL."
        },
        "aiCommitAssistant.kimi.model": {
          "type": "string",
          "default": "kimi-k2.6",
          "enum": [
            "kimi-k2.6",
            "kimi-k2.5",
            "kimi-k2-thinking",
            "kimi-k2-turbo-preview"
          ],
          "enumItemLabels": [
            "Kimi K2.6",
            "Kimi K2.5",
            "Kimi K2 Thinking",
            "Kimi K2 Turbo Preview"
          ],
          "markdownEnumDescriptions": [
            "Latest Kimi coding and agent model.",
            "Versatile multimodal Kimi model.",
            "Deep reasoning model.",
            "Preview fast K2 variant."
          ],
          "order": 40,
          "markdownDescription": "Kimi/Moonshot model used when provider is `kimi`. Use `Davinci AI Smart Commiter: Select Default Model` to change it without typing."
        },
        "aiCommitAssistant.kimi.baseUrl": {
          "type": "string",
          "default": "https://api.moonshot.ai/v1",
          "order": 41,
          "markdownDescription": "Kimi/Moonshot OpenAI-compatible API base URL."
        },
        "aiCommitAssistant.deepseek.model": {
          "type": "string",
          "default": "deepseek-v4-flash",
          "enum": [
            "deepseek-v4-flash",
            "deepseek-v4-pro",
            "deepseek-chat",
            "deepseek-reasoner"
          ],
          "enumItemLabels": [
            "DeepSeek V4 Flash",
            "DeepSeek V4 Pro",
            "DeepSeek Chat",
            "DeepSeek Reasoner"
          ],
          "markdownEnumDescriptions": [
            "Default fast model.",
            "Stronger reasoning/coding model.",
            "Legacy alias, deprecated after 2026-07-24.",
            "Legacy reasoning alias, deprecated after 2026-07-24."
          ],
          "order": 50,
          "markdownDescription": "DeepSeek model used when provider is `deepseek`. Use `Davinci AI Smart Commiter: Select Default Model` to change it without typing."
        },
        "aiCommitAssistant.deepseek.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "order": 51,
          "markdownDescription": "DeepSeek OpenAI-compatible API base URL."
        },
        "aiCommitAssistant.gemini.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "enum": [
            "gemini-2.5-flash",
            "gemini-2.5-flash-lite",
            "gemini-2.5-pro"
          ],
          "enumItemLabels": [
            "Gemini 2.5 Flash",
            "Gemini 2.5 Flash-Lite",
            "Gemini 2.5 Pro"
          ],
          "markdownEnumDescriptions": [
            "Best price-performance default.",
            "Fastest and most budget-friendly 2.5 model.",
            "More advanced reasoning and coding."
          ],
          "order": 60,
          "markdownDescription": "Google Gemini model used when provider is `gemini`. Use `Davinci AI Smart Commiter: Select Default Model` to change it without typing."
        },
        "aiCommitAssistant.gemini.baseUrl": {
          "type": "string",
          "default": "https://generativelanguage.googleapis.com/v1beta/openai",
          "order": 61,
          "markdownDescription": "Google Gemini OpenAI-compatible API base URL."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.26.0",
    "typescript": "^5.4.0"
  }
}
